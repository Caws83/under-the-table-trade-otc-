# Public configuration only. Do not put mainnet private keys in this file.
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545
NEXT_PUBLIC_DESK_ADDRESS=
NEXT_PUBLIC_FACTORY_ADDRESS=
NEXT_PUBLIC_TOKEN_STAKE=
NEXT_PUBLIC_TOKEN_PAY=

# Optional Reown project id from https://cloud.reown.com
# Leave empty to use an injected wallet plus the local development wallet.
NEXT_PUBLIC_REOWN_PROJECT_ID=

# Local Anvil only. Keep this false unless the RPC above is 127.0.0.1 or localhost.
# Never put a live private key here. Use the public Anvil development accounts
# documented by Foundry, and only inside a gitignored .env.local file.
NEXT_PUBLIC_DEV_MODE=false
NEXT_PUBLIC_DEV_KEY_A=
NEXT_PUBLIC_DEV_KEY_B=
